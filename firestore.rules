rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Two independent levels: official Academy email is a NORMAL Admin;
    // the separately authorized operator has the only Master Admin role.
    // All sensitive privileges are enforced on the server, not just UI labels.
    function isNormalAdmin() {
      return request.auth != null
        && request.auth.token.email == 'alislaharabicacademy@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isMasterAdmin() {
      return request.auth != null
        && request.auth.token.email == 'syedatheil40@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasPrivateAdminGrant() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminAccess/$(request.auth.token.email)).data.enabled == true;
    }

    function isAdmin() {
      return isNormalAdmin() || isMasterAdmin() || hasPrivateAdminGrant();
    }

    // Authorised Principal can cut a rehearsal ribbon, but cannot manage academy data.
    function isLaunchPrincipal() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/grandLaunch/config)
        && get(/databases/$(database)/documents/grandLaunch/config).data.principalEmail == request.auth.token.email;
    }

    // Saturday 21 November 2026 in Asia/Kolkata (UTC+05:30).
    function isOfficialOpeningDay() {
      return request.time >= timestamp.date(2026, 11, 20)
          + duration.value(18, 'h') + duration.value(30, 'm')
        && request.time < timestamp.date(2026, 11, 21)
          + duration.value(18, 'h') + duration.value(30, 'm');
    }

    function signedInTeacher(teacherId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/teacherAccess/$(teacherId))
        && get(/databases/$(database)/documents/teacherAccess/$(teacherId)).data.email == request.auth.token.email;
    }

    // Only Master Admin can add or revoke normal administrator access.
    // The public Academy contact email has NORMAL rights and cannot change
    // role grants or promote itself. No account can self-assign Master.
    match /adminAccess/{grantEmail} {
      allow get: if isMasterAdmin()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == grantEmail);
      allow list: if false;
      allow create, update: if isMasterAdmin()
        && grantEmail.matches('^[^/@ ]+@[^/@ ]+\\.[^/@ ]+$')
        && grantEmail != 'alislaharabicacademy@gmail.com'
        && grantEmail != 'syedatheil40@gmail.com'
        && request.resource.data.keys().hasOnly(['enabled','updatedAt','grantedBy'])
        && request.resource.data.keys().hasAll(['enabled','updatedAt','grantedBy'])
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.grantedBy == request.auth.uid;
      allow delete: if isMasterAdmin()
        && grantEmail != 'alislaharabicacademy@gmail.com'
        && grantEmail != 'syedatheil40@gmail.com';
    }

    // Role probe: no role emails are exposed to normal Admins in browser
    // code. Master gets a successful GET even when this sentinel is absent;
    // a normal Admin gets permission-denied. No reads of other roles/writes.
    match /adminRoleChecks/{role} {
      allow get: if role == 'master' && isMasterAdmin();
      allow list, create, update, delete: if false;
    }

    // Auditable, read-only administrator preview of teacher dashboards.
    // Teacher identity is never replaced by an administrator identity.
    match /adminTeacherPreviews/{eventId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['teacherId','actorUid','actorEmail','createdAt','purpose'])
        && request.resource.data.keys().hasAll(['teacherId','actorUid','actorEmail','createdAt','purpose'])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherId.size() > 0
        && request.resource.data.teacherId.size() <= 160
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.purpose == 'teacher_dashboard_preview'
        && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId));
      // The owner can inspect a permanent audit trail in Firebase.
      allow get, list: if isMasterAdmin();
      allow update, delete: if false;
    }

    // Read-only administrator previews of private student academic dashboards.
    // Every individual preview is recorded before the profile is opened.
    // Records are append-only, and the real signed-in admin is preserved.
    match /adminStudentPreviews/{eventId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'studentId', 'actorUid', 'actorEmail', 'createdAt', 'purpose'
        ])
        && request.resource.data.keys().hasAll([
          'studentId', 'actorUid', 'actorEmail', 'createdAt', 'purpose'
        ])
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.studentId.size() <= 160
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.purpose == 'student_dashboard_preview'
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId));
      // Owner can inspect the permanent audit trail in Firebase.
      allow get, list: if isMasterAdmin();
      allow update, delete: if false;
    }

    // Official ID cards: admins issue, publish, revoke and reissue cards.
    // Card photos/contact data are private; public QR verification uses a
    // separate minimally scoped document with an unguessable 128-bit token.
    function isIssuedCardOwner(cardId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.published == true
        && resource.data.status == 'active'
        && (
          (
            resource.data.kind == 'student'
            && cardId == 'student__' + resource.data.holderId
            && exists(/databases/$(database)/documents/studentAccess/$(resource.data.holderId))
            && get(/databases/$(database)/documents/studentAccess/$(resource.data.holderId)).data.enabled == true
            && get(/databases/$(database)/documents/studentAccess/$(resource.data.holderId)).data.email == request.auth.token.email
          )
          || (
            resource.data.kind == 'teacher'
            && cardId == 'teacher__' + resource.data.holderId
            && exists(/databases/$(database)/documents/teacherAccess/$(resource.data.holderId))
            && get(/databases/$(database)/documents/teacherAccess/$(resource.data.holderId)).data.email == request.auth.token.email
          )
        );
    }

    match /idCardSettings/{docId} {
      allow get: if isAdmin() && docId == 'current';
      allow list: if false;
      allow create, update, delete: if isAdmin() && docId == 'current';
    }

    match /idCards/{cardId} {
      allow get: if isAdmin() || isIssuedCardOwner(cardId);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.kind in ['student','teacher']
        && request.resource.data.holderId is string
        && request.resource.data.holderId.size() > 0
        && request.resource.data.holderId.size() <= 160
        && cardId == request.resource.data.kind + '__' + request.resource.data.holderId
        && request.resource.data.verificationCode is string
        && request.resource.data.verificationCode.matches('^[a-f0-9]{32}$')
        && request.resource.data.published == true
        && request.resource.data.status in ['active','revoked']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.validUntil is string
        && request.resource.data.validUntil.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow delete: if isAdmin();
    }

    match /idCardPublic/{token} {
      // Only direct links to a high-entropy identifier; no listing or
      // student-address/guardian/blood-group/phone fields are permitted.
      allow get: if token.matches('^[a-f0-9]{32}$')
        && resource.data.published == true;
      allow list: if false;
      allow create, update: if isAdmin()
        && token.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly([
          'published','status','kind','holderName','displayId','validUntil'
        ])
        && request.resource.data.keys().hasAll([
          'published','status','kind','holderName','displayId','validUntil'
        ])
        && request.resource.data.published == true
        && request.resource.data.status in ['active','revoked']
        && request.resource.data.kind in ['student','teacher']
        && request.resource.data.holderName is string
        && request.resource.data.holderName.size() > 0
        && request.resource.data.holderName.size() <= 120
        && request.resource.data.displayId is string
        && request.resource.data.displayId.size() <= 48
        && request.resource.data.validUntil is string
        && request.resource.data.validUntil.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow delete: if isAdmin();
    }

    // Published website appearance and principal signatory profile.
    // Public read is intentional because official certificate PDFs can be downloaded
    // through unguessable published result links. Only verified Academy admin writes.
    // Curated rank/name/photo ONLY, after explicit verified-admin selection.
    // Public visitors can fetch at most one homepage feature document.
    // When hidden, the app clears public entries and public photo data.
    match /homepageWinners/{docId} {
      allow get: if docId == 'current' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && docId == 'current';
    }
    // Ranked result IDs, uploads and guardian permission acknowledgements stay private.
    match /homepageWinnersAdmin/{docId} {
      allow read, write: if isAdmin() && docId == 'current';
    }

    // Visitors can fetch only the public careers document. Drafts are admin-only.
    match /hiringBoard/{docId} {
      allow get: if docId == 'current' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && docId == 'current';
    }
    match /hiringBoardAdmin/{docId} {
      allow read, write: if isAdmin() && docId == 'current';
    }

    // Launch practice is separate from any one-time official launch record.
    match /grandLaunch/{documentId} {
      allow get: if documentId in ['config', 'trial', 'officialControl', 'official']
        && (isAdmin() || isLaunchPrincipal());
      allow list, delete: if false;

      allow create, update: if documentId == 'config' && isAdmin()
        && request.resource.data.keys().hasOnly(['principalEmail','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['principalEmail','updatedAt','updatedBy'])
        && request.resource.data.principalEmail is string
        && request.resource.data.principalEmail.matches('^[^/@ ]+@[^/@ ]+\\.[^/@ ]+$')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      // Host can only start or reset a reversible trial.
      allow create, update: if documentId == 'trial' && isAdmin()
        && request.resource.data.keys().hasOnly(['kind','phase','startedAt','cutAt','cutBy','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['kind','phase','startedAt','cutAt','cutBy','updatedAt','updatedBy'])
        && request.resource.data.kind == 'trial'
        && request.resource.data.phase in ['idle','countdown']
        && request.resource.data.cutAt == null
        && request.resource.data.cutBy == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (request.resource.data.phase == 'idle' && request.resource.data.startedAt == null)
          || (request.resource.data.phase == 'countdown' && request.resource.data.startedAt == request.time)
        );

      // Principal or Admin can cut the TRIAL only after the full 5 seconds.
      // Admin access allows solo rehearsal; official launch remains unavailable.
      allow update: if documentId == 'trial' && (isLaunchPrincipal() || isAdmin())
        && resource.data.kind == 'trial'
        && resource.data.phase == 'countdown'
        && resource.data.startedAt is timestamp
        && request.time >= resource.data.startedAt + duration.value(5, 's')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phase','cutAt','cutBy','updatedAt','updatedBy'
        ])
        && request.resource.data.kind == 'trial'
        && request.resource.data.phase == 'cut'
        && request.resource.data.cutAt == request.time
        && request.resource.data.cutBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      // Master Admin alone prepares and starts the one-time ceremony.
      // Official launch recording permanently blocks changes to this control.
      allow create: if documentId == 'officialControl' && isMasterAdmin()
        && !exists(/databases/$(database)/documents/grandLaunch/official)
        && request.resource.data.keys().hasOnly(['kind','state','startedAt','startedBy','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['kind','state','startedAt','startedBy','updatedAt','updatedBy'])
        && request.resource.data.kind == 'officialControl'
        && request.resource.data.state == 'armed'
        && request.resource.data.startedAt == null
        && request.resource.data.startedBy == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if documentId == 'officialControl' && isMasterAdmin()
        && !exists(/databases/$(database)/documents/grandLaunch/official)
        && resource.data.kind == 'officialControl'
        && request.resource.data.keys().hasOnly(['kind','state','startedAt','startedBy','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['kind','state','startedAt','startedBy','updatedAt','updatedBy'])
        && request.resource.data.kind == 'officialControl'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          // Final countdown is allowed ONLY on the event day (India time).
          (resource.data.state == 'armed' && request.resource.data.state == 'countdown'
            && isOfficialOpeningDay()
            && request.resource.data.startedAt == request.time
            && request.resource.data.startedBy == request.auth.uid)
          ||
          // Master can cancel the countdown while the official record is absent.
          (resource.data.state == 'countdown' && request.resource.data.state == 'armed'
            && request.resource.data.startedAt == null
            && request.resource.data.startedBy == null)
        );

      // One immutable record is the genuine launch; no update/delete allowed.
      allow create: if documentId == 'official'
        && (isLaunchPrincipal() || isMasterAdmin())
        && isOfficialOpeningDay()
        && exists(/databases/$(database)/documents/grandLaunch/officialControl)
        && get(/databases/$(database)/documents/grandLaunch/officialControl).data.state == 'countdown'
        && get(/databases/$(database)/documents/grandLaunch/officialControl).data.startedAt is timestamp
        && request.time >= get(/databases/$(database)/documents/grandLaunch/officialControl).data.startedAt
          + duration.value(5, 's')
        && request.resource.data.keys().hasOnly(['kind','phase','dateLocal','startedAt','launchedAt','launchedBy'])
        && request.resource.data.keys().hasAll(['kind','phase','dateLocal','startedAt','launchedAt','launchedBy'])
        && request.resource.data.kind == 'official'
        && request.resource.data.phase == 'launched'
        && request.resource.data.dateLocal == '2026-11-21'
        && request.resource.data.startedAt
          == get(/databases/$(database)/documents/grandLaunch/officialControl).data.startedAt
        && request.resource.data.launchedAt == request.time
        && request.resource.data.launchedBy == request.auth.uid;
    }

    match /siteSettings/{settingId} {
      allow get: if settingId == 'public' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && settingId == 'public';
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin()
        && courseId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    match /classSubjects/{courseId} {
      allow read, write: if isAdmin();
    }

    match /students/{studentId} {
      // Full student and guardian information remains admin only.
      allow read, write: if isAdmin();
    }
    // One atomic counter and permanent reservation per ALIA00001–ALIA99999.
    // Student IDs are never used as passwords or authentication secrets.
    match /academyCounters/{counterId} {
      allow read, write: if isAdmin();
    }
    match /studentIdRegistry/{officialId} {
      // Once an ID is issued, no web client can edit, delete or reuse it.
      allow read, create: if isAdmin()
        && officialId.matches('^ALIA[0-9]{5}$');
      allow update, delete: if false;
    }

    // Admin-approved student/guardian Firebase Authentication accounts.
    // Students can only query their own verified, enabled account grants.
    // No password, DOB or private student profile stored here.
    match /studentAccess/{studentId} {
      allow get, list: if isAdmin()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
          && resource.data.enabled == true);
      allow create, update, delete: if isAdmin();
    }

    // Published exam result only through an unguessable 96-bit document code.
    // Public visitors cannot list or search student records or drafts.
    match /examResults/{resultId} {
      allow get: if isAdmin()
        || (resultId.matches('^RESULT-[a-f0-9]{24}$')
          && resource.data.published == true);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Opaque key = SHA-256(student UUID + DOB + application-specific domain).
    // No student names or birthdates are stored here. Anyone who knows both
    // confidential values can locate published result references; lists denied.
    match /examResultLookups/{lookupHash} {
      allow get: if isAdmin()
        || (lookupHash.matches('^[a-f0-9]{64}$')
          && resource.data.enabled == true);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read, write: if isAdmin();
    }

    // Immutable salary audit trail: admin can add and read historical changes,
    // but no client is permitted to rewrite or delete a recorded event.
    match /teacherSalaryEvents/{eventId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /teacherAccess/{teacherId} {
      allow get: if isAdmin()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email);
      allow list, create, update, delete: if isAdmin();
    }

    match /teacherRosters/{teacherId} {
      allow get: if isAdmin() || signedInTeacher(teacherId);
      allow list, create, update, delete: if isAdmin();
    }

    // Class postponement is teacher-requested, but cannot be approved by teachers.
    match /classRescheduleRequests/{teacherId}/requests/{requestId} {
      allow get, list: if isAdmin() || signedInTeacher(teacherId);
      allow create: if signedInTeacher(teacherId)
        && request.resource.data.keys().hasOnly([
          'teacherId','teacherName','teacherEmail','course','courseName',
          'batch','subject','timing','originalDate','proposedDate','proposedTime',
          'reason','status','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'teacherId','teacherName','teacherEmail','course','courseName',
          'batch','subject','timing','originalDate','proposedDate','proposedTime',
          'reason','status','createdAt','updatedAt'
        ])
        && request.resource.data.teacherId == teacherId
        && request.resource.data.teacherEmail == request.auth.token.email
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() <= 120
        && request.resource.data.course is string
        && request.resource.data.course.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.courseName is string
        && request.resource.data.courseName.size() <= 150
        && request.resource.data.batch is string
        && request.resource.data.batch.size() <= 100
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 150
        && request.resource.data.timing is string
        && request.resource.data.timing.size() <= 150
        && request.resource.data.originalDate is string
        && request.resource.data.originalDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.proposedDate is string
        && (request.resource.data.proposedDate == ''
          || (request.resource.data.proposedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.proposedDate > request.resource.data.originalDate))
        && request.resource.data.proposedTime is string
        && (request.resource.data.proposedTime == ''
          || request.resource.data.proposedTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && ((request.resource.data.proposedDate == '') == (request.resource.data.proposedTime == ''))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Teacher can only propose a different date after Admin specifically asks.
      allow update: if isAdmin() || (
        signedInTeacher(teacherId)
        && resource.data.status == 'date_change_requested'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','proposedDate','proposedTime','updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.proposedDate is string
        && request.resource.data.proposedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.proposedDate > resource.data.originalDate
        && request.resource.data.proposedTime is string
        && request.resource.data.proposedTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin();
    }

    // A claimed makeup must match an Admin-approved request for this exact date,
    // teacher, course, subject, original date and unique request key.
    function validSubmittedClass(teacherId, day, key, record) {
      return record is map && (
        (
          !key.matches('.*__makeup__.*')
          && !record.keys().hasAny(['classType', 'rescheduleRequestId'])
        ) || (
          record.classType == 'makeup'
          && record.rescheduleRequestId is string
          && record.rescheduleRequestId.size() <= 100
          && record.course is string
          && record.batch is string
          && record.subject is string
          && record.originalDate is string
          && key == record.course + '__'
            + ((record.course == 'maktab' || record.course == 'childrens-quran-maktab')
              ? record.batch + '__' : '')
            + record.subject + '__makeup__' + record.rescheduleRequestId
          && exists(/databases/$(database)/documents/classRescheduleRequests/$(teacherId)/requests/$(record.rescheduleRequestId))
          && get(/databases/$(database)/documents/classRescheduleRequests/$(teacherId)/requests/$(record.rescheduleRequestId)).data.status == 'approved'
          && get(/databases/$(database)/documents/classRescheduleRequests/$(teacherId)/requests/$(record.rescheduleRequestId)).data.confirmedDate == day
          && get(/databases/$(database)/documents/classRescheduleRequests/$(teacherId)/requests/$(record.rescheduleRequestId)).data.originalDate == record.originalDate
          && get(/databases/$(database)/documents/classRescheduleRequests/$(teacherId)/requests/$(record.rescheduleRequestId)).data.course == record.course
          && get(/databases/$(database)/documents/classRescheduleRequests/$(teacherId)/requests/$(record.rescheduleRequestId)).data.batch == record.batch
          && get(/databases/$(database)/documents/classRescheduleRequests/$(teacherId)/requests/$(record.rescheduleRequestId)).data.subject == record.subject
        )
      );
    }

    match /teacherAttendance/{teacherId}/days/{day} {
      allow get: if isAdmin() || signedInTeacher(teacherId);
      allow list: if isAdmin();

      allow create: if signedInTeacher(teacherId)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'date', 'teacherId', 'email', 'markedAt', 'subjects'
        ])
        && request.resource.data.keys().hasAll([
          'date', 'teacherId', 'email', 'markedAt', 'subjects'
        ])
        && request.resource.data.date == day
        && request.resource.data.teacherId == teacherId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.markedAt == request.time
        && request.resource.data.subjects is map
        && request.resource.data.subjects.size() == 1
        && validSubmittedClass(teacherId, day,
          request.resource.data.subjects.keys()[0],
          request.resource.data.subjects[request.resource.data.subjects.keys()[0]]);

      allow update: if isAdmin()
        || (
          signedInTeacher(teacherId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['subjects', 'markedAt'])
          && request.resource.data.date == resource.data.date
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.email == resource.data.email
          && request.resource.data.markedAt == request.time
          && resource.data.subjects is map
          && request.resource.data.subjects is map
          && request.resource.data.subjects.size() == resource.data.subjects.size() + 1
          && request.resource.data.subjects.diff(resource.data.subjects).removedKeys().size() == 0
          && request.resource.data.subjects.diff(resource.data.subjects).changedKeys().size() == 0
           && validSubmittedClass(teacherId, day,
             request.resource.data.subjects.keys().removeAll(resource.data.subjects.keys())[0],
             request.resource.data.subjects[request.resource.data.subjects.keys().removeAll(resource.data.subjects.keys())[0]])
        );

      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      // Applicants may create new records only. Only admins can read or edit.
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        applicationId.matches('^MIA-[0-9]{8}-[A-Z0-9]{8}$')
        && request.resource.data.keys().hasAll([
          'reference', 'studentName', 'guardianName', 'age', 'phone',
          'email', 'course', 'address', 'dob', 'additionalFields',
          'message', 'submittedAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'reference', 'studentName', 'guardianName', 'age', 'phone',
          'email', 'course', 'address', 'dob', 'additionalFields',
          'message', 'submittedAt', 'status'
        ])
        && request.resource.data.reference is string
        && request.resource.data.reference == applicationId
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.guardianName is string
        && request.resource.data.guardianName.size() <= 120
        && request.resource.data.age is string
        && request.resource.data.age.matches('^[0-9]{1,3}$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+ ()-]{7,20}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && (
          request.resource.data.email == ''
          || request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        )
        && request.resource.data.course is string
        && request.resource.data.course.size() >= 2
        && request.resource.data.course.size() <= 120
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 4
        && request.resource.data.address.size() <= 500
        && request.resource.data.dob is string
        && request.resource.data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.additionalFields is string
        && request.resource.data.additionalFields.size() <= 8192
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.submittedAt == request.time
        && request.resource.data.status == 'New'
      );
    }

    // Shared, unguessable Academy-generated intake link for students who
    // joined before the website existed. Closed by default; staff enable it
    // explicitly, and the link expires automatically after a limited window.
    // No student/guardian data is stored in an invitation.
    match /existingStudentIntakeLinks/{token} {
      allow get: if isAdmin() || (
        token.matches('^[a-f0-9]{64}$')
        && resource.data.enabled == true
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
      );
      // List queries have no concrete token document ID. Applying a regex
      // guard to that unbound wildcard blocks even approved administrators
      // from listing links, so Create/Rotate fails before it writes anything.
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin()
        && token.matches('^[a-f0-9]{64}$');
    }

    // Self-submitted registration details are private and only create an
    // ADMIN REVIEW REQUEST. Applicants cannot list, read, edit, approve,
    // create official ALIA numbers or change existing student records.
    match /existingStudentRequests/{requestId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        requestId.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasAll([
          'name','guardian','dob','phone','email','joiningDate','course',
          'courseYear','batch','address','notes','photoData','linkToken',
          'educationLevel','schoolStandard','collegeCourse','collegeYear','institutionName',
          'source','status','submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name','guardian','dob','phone','email','joiningDate','course',
          'courseYear','batch','address','notes','photoData','linkToken',
          'educationLevel','schoolStandard','collegeCourse','collegeYear','institutionName',
          'source','status','submittedAt'
        ])
        && request.resource.data.linkToken is string
        && request.resource.data.linkToken.matches('^[a-f0-9]{64}$')
        && exists(/databases/$(database)/documents/existingStudentIntakeLinks/$(request.resource.data.linkToken))
        && get(/databases/$(database)/documents/existingStudentIntakeLinks/$(request.resource.data.linkToken)).data.enabled == true
        && get(/databases/$(database)/documents/existingStudentIntakeLinks/$(request.resource.data.linkToken)).data.expiresAt > request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.guardian is string
        && request.resource.data.guardian.size() >= 2
        && request.resource.data.guardian.size() <= 120
        && request.resource.data.dob is string
        && request.resource.data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.joiningDate is string
        && request.resource.data.joiningDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+() .-]{7,25}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^/@ ]+@[^/@ ]+\\.[^/@ ]+$')
        && request.resource.data.course is string
        // A submitted course must exist in the canonical, Admin-controlled
        // Academy registry and be published for existing registration.
        && request.resource.data.course.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.course != 'admission-form-config'
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.course))
        && get(/databases/$(database)/documents/courses/$(request.resource.data.course)).data.published == true
        && get(/databases/$(database)/documents/courses/$(request.resource.data.course)).data.name is string
        && request.resource.data.courseYear is int
        && (
          (request.resource.data.course == 'muballigha'
            && request.resource.data.courseYear in [1,2])
          || (request.resource.data.course == 'alima'
            && request.resource.data.courseYear == 3)
          || (request.resource.data.course != 'muballigha'
            && request.resource.data.course != 'alima'
            && request.resource.data.courseYear == 0)
        )
        && request.resource.data.batch is string
        && request.resource.data.batch.size() <= 60
        && (!(request.resource.data.course in ['maktab','childrens-quran-maktab'])
          || request.resource.data.batch.size() > 0)
        && request.resource.data.educationLevel is string
        && request.resource.data.educationLevel in ['school','college','not-studying']
        && request.resource.data.schoolStandard is string
        && request.resource.data.schoolStandard.size() <= 6
        && request.resource.data.collegeCourse is string
        && request.resource.data.collegeCourse.size() <= 120
        && request.resource.data.collegeYear is string
        && request.resource.data.collegeYear.matches('^([1-6])?$')
        && request.resource.data.institutionName is string
        && request.resource.data.institutionName.size() <= 150
        && (
          (request.resource.data.educationLevel == 'school'
            && request.resource.data.schoolStandard.matches('^(Pre-KG|LKG|UKG|[1-9]|1[0-2])$')
            && request.resource.data.collegeCourse == ''
            && request.resource.data.collegeYear == '')
          || (request.resource.data.educationLevel == 'college'
            && request.resource.data.schoolStandard == ''
            && request.resource.data.collegeCourse.size() >= 2)
          || (request.resource.data.educationLevel == 'not-studying'
            && request.resource.data.schoolStandard == ''
            && request.resource.data.collegeCourse == ''
            && request.resource.data.collegeYear == ''
            && request.resource.data.institutionName == '')
        )
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 700
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 105000
        && (
          request.resource.data.photoData == ''
          || request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        )
        && request.resource.data.source == 'existing-academy-student-form'
        && request.resource.data.status == 'Pending Review'
        && request.resource.data.submittedAt == request.time
      );
    }

    // One-time existing-student update invitations.
    // Parents submit to a private review queue, never directly to students/.
    match /studentUpdateInvites/{token} {
      allow get: if isAdmin() || (
        token.matches('^[a-f0-9]{64}$')
        && request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email
      );
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        token.matches('^[a-f0-9]{64}$')
        && request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email
        && resource.data.used == false
        && resource.data.revoked == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedAt == request.time
        && existsAfter(/databases/$(database)/documents/studentUpdateSubmissions/$(token))
      );
    }
    match /studentUpdateSubmissions/{token} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        token.matches('^[a-f0-9]{64}$')
        && request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/studentUpdateInvites/$(token))
        && get(/databases/$(database)/documents/studentUpdateInvites/$(token)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/studentUpdateInvites/$(token)).data.revoked == false
        && get(/databases/$(database)/documents/studentUpdateInvites/$(token)).data.used == false
        && getAfter(/databases/$(database)/documents/studentUpdateInvites/$(token)).data.used == true
        && getAfter(/databases/$(database)/documents/studentUpdateInvites/$(token)).data.usedAt == request.time
        && request.resource.data.keys().hasAll([
          'name','dob','guardian','phone','course','email','address','notes','submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name','dob','guardian','phone','course','email','address','notes','submittedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.guardian is string
        && request.resource.data.guardian.size() >= 2
        && request.resource.data.guardian.size() <= 120
        && request.resource.data.dob is string
        && request.resource.data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 25
        && request.resource.data.course is string
        && request.resource.data.course.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.course.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 700
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.submittedAt == request.time
      );
    }

    match /teacherInvites/{token} {
      allow get: if isAdmin()
        || (
          token.matches('^[a-f0-9]{64}$')
          && request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
        );

      allow list, create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          token.matches('^[a-f0-9]{64}$')
          && request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
          && resource.data.used == false
          && resource.data.revoked == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt'])
          && request.resource.data.used == true
          && existsAfter(/databases/$(database)/documents/teacherSubmissions/$(token))
        );
    }

    match /teacherSubmissions/{token} {
      allow read, update, delete: if isAdmin();

      allow create: if token.matches('^[a-f0-9]{64}$')
        && request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/teacherInvites/$(token))
        && get(/databases/$(database)/documents/teacherInvites/$(token)).data.email == request.auth.token.email
        && request.resource.data.email == request.auth.token.email
        && get(/databases/$(database)/documents/teacherInvites/$(token)).data.used == false
        && get(/databases/$(database)/documents/teacherInvites/$(token)).data.revoked == false
        && getAfter(/databases/$(database)/documents/teacherInvites/$(token)).data.used == true
        && request.resource.data.keys().hasOnly([
          'fullName', 'dob', 'phone', 'email', 'address', 'academicEducation',
          'academicInstitution', 'academicYear', 'madrasaName',
          'madrasaLocation', 'sanad', 'sanadInstitution', 'sanadYear',
          'experience', 'previousInstitution', 'subjects', 'languages',
          'notes', 'photoPath', 'photoData', 'academicPath', 'sanadPath', 'submittedAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 25
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 700
        && request.resource.data.madrasaName is string
        && request.resource.data.madrasaName.size() > 0
        && request.resource.data.madrasaName.size() <= 200
        && request.resource.data.sanad is string
        && request.resource.data.sanad.size() > 0
        && request.resource.data.sanad.size() <= 200
        && (
          !('photoPath' in request.resource.data)
          || request.resource.data.photoPath.matches(
            '^teacher-registration/' + token + '/photo\\.(jpg|png)$'
          )
        )
        && (
          !('photoData' in request.resource.data)
          || (
            request.resource.data.photoData is string
            && request.resource.data.photoData.size() <= 105000
            && request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          )
        )
        && (
          !('academicPath' in request.resource.data)
          || request.resource.data.academicPath.matches(
            '^teacher-registration/' + token + '/academic\\.(jpg|png|pdf)$'
          )
        )
        && (
          !('sanadPath' in request.resource.data)
          || request.resource.data.sanadPath.matches(
            '^teacher-registration/' + token + '/sanadFile\\.(jpg|png|pdf)$'
          )
        );
    }
  }
}
