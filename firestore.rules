rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.email == 'alislaharabicacademy@gmail.com';
  }
  function signedInTeacher(teacherId) {
   return request.auth != null && request.auth.token.email_verified == true
    && exists(/databases/$(database)/documents/teacherAccess/$(teacherId))
    && get(/databases/$(database)/documents/teacherAccess/$(teacherId)).data.email == request.auth.token.email;
  }
  match /courses/{courseId} {
   allow read: if isAdmin() || resource.data.published == true;
   allow create, update, delete: if isAdmin() && courseId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
  }
  match /students/{id} { allow read, write: if isAdmin(); }
  match /teachers/{id} { allow read, write: if isAdmin(); }
  match /teacherAccess/{id} {
   allow get: if isAdmin() || (request.auth != null && request.auth.token.email_verified == true && resource.data.email == request.auth.token.email);
   allow list, create, update, delete: if isAdmin();
  }
  match /teacherAttendance/{teacherId}/days/{day} {
   allow get: if isAdmin() || signedInTeacher(teacherId);
   allow list: if isAdmin();
   allow create: if signedInTeacher(teacherId)
    && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.resource.data.keys().hasOnly(['date','teacherId','email','markedAt','subjects'])
    && request.resource.data.date == day
    && request.resource.data.teacherId == teacherId
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.markedAt == request.time
    && request.resource.data.subjects is map
    && request.resource.data.subjects.size() == 1;
   allow update: if isAdmin() || (
    signedInTeacher(teacherId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subjects','markedAt'])
    && request.resource.data.subjects is map
    && resource.data.subjects is map
    && request.resource.data.subjects.diff(resource.data.subjects).removedKeys().size() == 0
    && request.resource.data.subjects.diff(resource.data.subjects).changedKeys().size() == 0
    && request.resource.data.subjects.diff(resource.data.subjects).addedKeys().size() == 1
    && request.resource.data.markedAt == request.time
   );
   allow delete: if isAdmin();
  }
  match /applications/{id} {
   allow read, update, delete: if isAdmin();
   allow create: if false;
  }
  match /teacherInvites/{token} {
   allow get: if isAdmin() || (request.auth != null
    && request.auth.token.email_verified == true
    && resource.data.email == request.auth.token.email);
   allow list, create, delete: if isAdmin();
   allow update: if isAdmin() || (
    request.auth != null && request.auth.token.email_verified == true
    && resource.data.email == request.auth.token.email
    && resource.data.used == false && resource.data.revoked == false
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedAt'])
    && request.resource.data.used == true
    && existsAfter(/databases/$(database)/documents/teacherSubmissions/$(token))
   );
  }
  match /teacherSubmissions/{token} {
   allow read, update, delete: if isAdmin();
   allow create: if token.matches('^[a-f0-9]{64}$')
    && request.auth != null && request.auth.token.email_verified == true
    && exists(/databases/$(database)/documents/teacherInvites/$(token))
    && get(/databases/$(database)/documents/teacherInvites/$(token)).data.email == request.auth.token.email
    && request.resource.data.email == request.auth.token.email
    && get(/databases/$(database)/documents/teacherInvites/$(token)).data.used == false
    && get(/databases/$(database)/documents/teacherInvites/$(token)).data.revoked == false
    && getAfter(/databases/$(database)/documents/teacherInvites/$(token)).data.used == true
    && request.resource.data.keys().hasOnly(['fullName','dob','phone','email','address','academicEducation','academicInstitution','academicYear','madrasaName','madrasaLocation','sanad','sanadInstitution','sanadYear','experience','previousInstitution','subjects','languages','notes','submittedAt'])
    && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120
    && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 25
    && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 700
    && request.resource.data.madrasaName is string && request.resource.data.madrasaName.size() > 0 && request.resource.data.madrasaName.size() <= 200
    && request.resource.data.sanad is string && request.resource.data.sanad.size() > 0 && request.resource.data.sanad.size() <= 200;
  }
 }
}