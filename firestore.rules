rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'alislaharabicacademy@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function signedInTeacher(teacherId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/teacherAccess/$(teacherId))
        && get(/databases/$(database)/documents/teacherAccess/$(teacherId)).data.email == request.auth.token.email;
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin()
        && courseId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    match /classSubjects/{courseId} {
      allow read, write: if isAdmin();
    }

    match /students/{studentId} {
      // Full student and guardian information remains admin only.
      allow read, write: if isAdmin();
    }
    // One atomic counter and permanent reservation per ALIA00001–ALIA99999.
    // Student IDs are never used as passwords or authentication secrets.
    match /academyCounters/{counterId} {
      allow read, write: if isAdmin();
    }
    match /studentIdRegistry/{officialId} {
      // Once an ID is issued, no web client can edit, delete or reuse it.
      allow read, create: if isAdmin()
        && officialId.matches('^ALIA[0-9]{5}$');
      allow update, delete: if false;
    }

    // Admin-approved student/guardian Firebase Authentication accounts.
    // Students can only query their own verified, enabled account grants.
    // No password, DOB or private student profile stored here.
    match /studentAccess/{studentId} {
      allow get, list: if isAdmin()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
          && resource.data.enabled == true);
      allow create, update, delete: if isAdmin();
    }

    // Published exam result only through an unguessable 96-bit document code.
    // Public visitors cannot list or search student records or drafts.
    match /examResults/{resultId} {
      allow get: if isAdmin()
        || (resultId.matches('^RESULT-[a-f0-9]{24}$')
          && resource.data.published == true);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Opaque key = SHA-256(student UUID + DOB + application-specific domain).
    // No student names or birthdates are stored here. Anyone who knows both
    // confidential values can locate published result references; lists denied.
    match /examResultLookups/{lookupHash} {
      allow get: if isAdmin()
        || (lookupHash.matches('^[a-f0-9]{64}$')
          && resource.data.enabled == true);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read, write: if isAdmin();
    }

    // Immutable salary audit trail: admin can add and read historical changes,
    // but no client is permitted to rewrite or delete a recorded event.
    match /teacherSalaryEvents/{eventId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /teacherAccess/{teacherId} {
      // A teacher may discover only the access grants for their own Google
      // email. The client query MUST constrain email == auth.token.email.
      allow get, list: if isAdmin()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && resource.data.email == request.auth.token.email);
      allow create, update, delete: if isAdmin();
    }

    match /teacherRosters/{teacherId} {
      allow get: if isAdmin() || signedInTeacher(teacherId);
      allow list, create, update, delete: if isAdmin();
    }

    match /teacherAttendance/{teacherId}/days/{day} {
      allow get: if isAdmin() || signedInTeacher(teacherId);
      allow list: if isAdmin();

      allow create: if signedInTeacher(teacherId)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'date', 'teacherId', 'email', 'markedAt', 'subjects'
        ])
        && request.resource.data.keys().hasAll([
          'date', 'teacherId', 'email', 'markedAt', 'subjects'
        ])
        && request.resource.data.date == day
        && request.resource.data.teacherId == teacherId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.markedAt == request.time
        && request.resource.data.subjects is map
        && request.resource.data.subjects.size() == 1;

      allow update: if isAdmin()
        || (
          signedInTeacher(teacherId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['subjects', 'markedAt'])
          && request.resource.data.date == resource.data.date
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.email == resource.data.email
          && request.resource.data.markedAt == request.time
          && resource.data.subjects is map
          && request.resource.data.subjects is map
          && request.resource.data.subjects.size() == resource.data.subjects.size() + 1
          && request.resource.data.subjects.diff(resource.data.subjects).removedKeys().size() == 0
          && request.resource.data.subjects.diff(resource.data.subjects).changedKeys().size() == 0
        );

      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      // Applicants may create new records only. Only admins can read or edit.
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        applicationId.matches('^MIA-[0-9]{8}-[A-Z0-9]{8}$')
        && request.resource.data.keys().hasAll([
          'reference', 'studentName', 'guardianName', 'age', 'phone',
          'email', 'course', 'address', 'dob', 'additionalFields',
          'message', 'submittedAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'reference', 'studentName', 'guardianName', 'age', 'phone',
          'email', 'course', 'address', 'dob', 'additionalFields',
          'message', 'submittedAt', 'status'
        ])
        && request.resource.data.reference is string
        && request.resource.data.reference == applicationId
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.guardianName is string
        && request.resource.data.guardianName.size() <= 120
        && request.resource.data.age is string
        && request.resource.data.age.matches('^[0-9]{1,3}$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+ ()-]{7,20}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && (
          request.resource.data.email == ''
          || request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        )
        && request.resource.data.course is string
        && request.resource.data.course.size() >= 2
        && request.resource.data.course.size() <= 120
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 4
        && request.resource.data.address.size() <= 500
        && request.resource.data.dob is string
        && request.resource.data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.additionalFields is string
        && request.resource.data.additionalFields.size() <= 8192
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.submittedAt == request.time
        && request.resource.data.status == 'New'
      );
    }

    match /teacherInvites/{token} {
      allow get: if isAdmin()
        || (
          token.matches('^[a-f0-9]{64}$')
          && request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
        );

      allow list, create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          token.matches('^[a-f0-9]{64}$')
          && request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
          && resource.data.used == false
          && resource.data.revoked == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt'])
          && request.resource.data.used == true
          && existsAfter(/databases/$(database)/documents/teacherSubmissions/$(token))
        );
    }

    match /teacherSubmissions/{token} {
      allow read, update, delete: if isAdmin();

      allow create: if token.matches('^[a-f0-9]{64}$')
        && request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/teacherInvites/$(token))
        && get(/databases/$(database)/documents/teacherInvites/$(token)).data.email == request.auth.token.email
        && request.resource.data.email == request.auth.token.email
        && get(/databases/$(database)/documents/teacherInvites/$(token)).data.used == false
        && get(/databases/$(database)/documents/teacherInvites/$(token)).data.revoked == false
        && getAfter(/databases/$(database)/documents/teacherInvites/$(token)).data.used == true
        && request.resource.data.keys().hasOnly([
          'fullName', 'dob', 'phone', 'email', 'address', 'academicEducation',
          'academicInstitution', 'academicYear', 'madrasaName',
          'madrasaLocation', 'sanad', 'sanadInstitution', 'sanadYear',
          'experience', 'previousInstitution', 'subjects', 'languages',
          'notes', 'photoPath', 'photoData', 'academicPath', 'sanadPath', 'submittedAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 25
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 700
        && request.resource.data.madrasaName is string
        && request.resource.data.madrasaName.size() > 0
        && request.resource.data.madrasaName.size() <= 200
        && request.resource.data.sanad is string
        && request.resource.data.sanad.size() > 0
        && request.resource.data.sanad.size() <= 200
        && (
          !('photoPath' in request.resource.data)
          || request.resource.data.photoPath.matches(
            '^teacher-registration/' + token + '/photo\\.(jpg|png)$'
          )
        )
        && (
          !('photoData' in request.resource.data)
          || (
            request.resource.data.photoData is string
            && request.resource.data.photoData.size() <= 105000
            && request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          )
        )
        && (
          !('academicPath' in request.resource.data)
          || request.resource.data.academicPath.matches(
            '^teacher-registration/' + token + '/academic\\.(jpg|png|pdf)$'
          )
        )
        && (
          !('sanadPath' in request.resource.data)
          || request.resource.data.sanadPath.matches(
            '^teacher-registration/' + token + '/sanadFile\\.(jpg|png|pdf)$'
          )
        );
    }
  }
}
