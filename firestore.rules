    && request.resource.data.keys().hasOnly(['fullName','dob','phone','email','address','academicEducation','academicInstitution','academicYear','madrasaName','madrasaLocation','sanad','sanadInstitution','sanadYear','experience','previousInstitution','subjects','languages','notes','photoPath','academicPath','sanadPath','submittedAt'])
    && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120
    && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 25
    && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 700
    && request.resource.data.madrasaName is string && request.resource.data.madrasaName.size() > 0 && request.resource.data.madrasaName.size() <= 200
    && request.resource.data.sanad is string && request.resource.data.sanad.size() > 0 && request.resource.data.sanad.size() <= 200
    && (!('photoPath' in request.resource.data) || request.resource.data.photoPath.matches('^teacher-registration/'+token+'/photo\\.(jpg|png)$'))
    && (!('academicPath' in request.resource.data) || request.resource.data.academicPath.matches('^teacher-registration/'+token+'/academic\\.(jpg|png|pdf)$'))
    && (!('sanadPath' in request.resource.data) || request.resource.data.sanadPath.matches('^teacher-registration/'+token+'/sanadFile\\.(jpg|png|pdf)$'));
  }
 }
})
